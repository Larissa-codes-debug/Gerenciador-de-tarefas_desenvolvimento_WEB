# Copie para backend/.env e preencha os valores locais.
NODE_ENV=development
PORT=3000

# PostgreSQL (no Docker Compose, os valores de conexão são sobrescritos pelo compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gerenciador_tarefas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DEFINA_UMA_SENHA_FORTE

# MongoDB (no Docker Compose, MONGODB_URI é sobrescrita pelo compose)
MONGODB_URI=mongodb://localhost:27017/gerenciador_tarefas

# JWT: gere uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE_DE_32_CARACTERES_OU_MAIS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
ACCESS_TOKEN_ISSUER=gerenciador-tarefas
ACCESS_TOKEN_AUDIENCE=gerenciador-tarefas-client

# Frontend local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Limites de requisições
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
TRUST_PROXY=false

# Conta administrativa usada somente pelo script npm run seed
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=DEFINA_UMA_SENHA_ADMINISTRATIVA_FORTE

# Recuperação de senha (opcional)
EXPOSE_RESET_TOKEN_IN_DEV=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
