{
  "info": {
    "name": "TaskFlow Institucional API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost/api" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "token", "value": "" }
  ],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Ready", "request": { "method": "GET", "url": "{{baseUrl}}/ready" } },
    {
      "name": "Login Admin",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const j = pm.response.json();",
        "pm.collectionVariables.set('token', j.token || j.accessToken || j.access_token || '');",
        "pm.test('Login OK', () => pm.response.to.have.status(200));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"senha\":\"{{adminPassword}}\"}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Listar Tarefas", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/tarefas" } },
    { "name": "Listar Areas", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/catalogos/areas" } },
    { "name": "Listar Usuarios", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/usuarios" } },
    { "name": "Sem token deve dar 401", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 sem token', () => pm.response.to.have.status(401));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/tarefas" } }
  ]
}